+#define AES_ROUND(T, w0, w1, w2, w3, k)         \
+((  T->table[0][ B0(w0) ]                       \
+  ^ T->table[1][ B1(w1) ]                       \
+  ^ T->table[2][ B2(w2) ]                       \
+  ^ T->table[3][ B3(w3) ]) ^ (k))
