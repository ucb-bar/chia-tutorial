+static PJPG_INLINE uint8
+getChar (void)
+{
+  if (!gInBufLeft)
+    {
+      fillInBuf ();
+      if (!gInBufLeft)
+	{
+	  gTemFlag = ~gTemFlag;
+	  return gTemFlag ? 0xFF : 0xD9;
+	}
+    }
+
+  gInBufLeft--;
+  return gInBuf[gInBufOfs++];
+}
