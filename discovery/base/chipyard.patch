+    case 10:
+      return 0xFFC0;
+    case 11:
+      return 0xFFE0;
+    case 12:
+      return 0xFFF0;
+    case 13:
+      return 0xFFF8;
+    case 14:
+      return 0xFFFC;
+    case 15:
+      return 0xFFFE;
+    default:
+      return 0xFFFF;
+    }
+}
