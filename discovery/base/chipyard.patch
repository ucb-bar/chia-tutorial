+//------------------------------------------------------------------------------
+static PJPG_INLINE uint8
+getOctet (uint8 FFCheck)
+{
+  uint8 c = getChar ();
+
+  if ((FFCheck) && (c == 0xFF))
+    {
+      uint8 n = getChar ();
+
+      if (n)
+	{
+	  stuffChar (n);
+	  stuffChar (0xFF);
+	}
+    }
+
+  return c;
+}
