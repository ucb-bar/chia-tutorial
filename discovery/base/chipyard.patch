+static PJPG_INLINE int16
+arithmeticRightShiftN16 (int16 x, int8 n)
+{
+  int16 r = (uint16) x >> (uint8) n;
+  if (x < 0)
+    r |= replicateSignBit16 (n);
+  return r;
+}
