+#if PJPG_RIGHT_SHIFT_IS_ALWAYS_UNSIGNED
+static int16
+replicateSignBit16 (int8 n)
+{
+  switch (n)
+    {
+    case 0:
+      return 0x0000;
+    case 1:
+      return 0x8000;
+    case 2:
+      return 0xC000;
+    case 3:
+      return 0xE000;
+    case 4:
+      return 0xF000;
+    case 5:
+      return 0xF800;
+    case 6:
+      return 0xFC00;
+    case 7:
+      return 0xFE00;
+    case 8:
