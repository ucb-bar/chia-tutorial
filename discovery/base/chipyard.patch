diff --git a/generators/chipyard/src/main/scala/dma/DMAController.scala b/generators/chipyard/src/main/scala/dma/DMAController.scala
new file mode 100644
index 0000000..0abf172
--- /dev/null
+++ b/generators/chipyard/src/main/scala/dma/DMAController.scala
@@ -0,0 +1,129 @@
+package chipyard.dma
+
+import chisel3._
+import chisel3.util._
+
+class DMACommand extends Bundle {
+  val funct = UInt(7.W)
+  val source = UInt(64.W)
+  val destination = UInt(64.W)
+  val rd = UInt(5.W)
+  val xd = Bool()
+  val xs1 = Bool()
+  val xs2 = Bool()
+}
+class DMAResponse extends Bundle {
+  val rd = UInt(5.W)
+  val status = UInt(64.W)
+}
+class DMARequest extends Bundle {
+  val address = UInt(64.W)
+  val write = Bool()
+  val data = UInt(64.W)
+}
+class DMAMemoryResponse extends Bundle {
+  val data = UInt(64.W)
+  val error = Bool()
+}
+
+/** Command ABI and one-unit datapath. Memory adapter owns TileLink encoding. */
+class DMAController(base: BigInt, size: BigInt) extends Module {
+  require(base >= 0 && size > 0 && base + size < (BigInt(1) << 64))
+  val io = IO(new Bundle {
+    val cmd = Flipped(Decoupled(new DMACommand))
+    val resp = Decoupled(new DMAResponse)
+    val request = Decoupled(new DMARequest)
+    val reply = Flipped(Decoupled(new DMAMemoryResponse))
+    val busy = Output(Bool())
+  })
+  val idle :: read :: readWait :: write :: writeWait :: complete :: Nil = Enum(6)
+  val state = RegInit(idle)
+  val configured = RegInit(false.B)
+  val srcConfig = Reg(UInt(64.W))
+  val dstConfig = Reg(UInt(64.W))
+  val src = Reg(UInt(64.W))
+  val dst = Reg(UInt(64.W))
+  val left = Reg(UInt(64.W))
+  val buffer = Reg(UInt(64.W))
+  val rd = Reg(UInt(5.W))
+  val status = Reg(UInt(64.W))
+  val respond = Reg(Bool())
+
+  io.cmd.ready := state === idle
+  io.busy := state =/= idle
+  io.resp.valid := state === complete && respond
+  io.resp.bits.rd := rd
+  io.resp.bits.status := status
+  io.request.valid := state === read || state === write
+  io.request.bits.address := Mux(state === write, dst, src)
+  io.request.bits.write := state === write
+  io.request.bits.data := buffer
+  io.reply.ready := state === readWait || state === writeWait
+
+  // Widened sums reject overflow before narrowing to the physical TL address.
+  val n = io.cmd.bits.source
+  val srcEnd = srcConfig +& n
+  val dstEnd = dstConfig +& n
+  val validRange = srcConfig >= base.U && dstConfig >= base.U &&
+    srcEnd <= (base + size).U && dstEnd <= (base + size).U
+  val disjoint = srcEnd <= dstConfig || dstEnd <= srcConfig
+  val aligned = (srcConfig(2,0) | dstConfig(2,0) | n(2,0)) === 0.U
+
+  when(io.cmd.fire) {
+    rd := io.cmd.bits.rd
+    respond := io.cmd.bits.xd
+    status := 1.U
+    state := complete
+    when(io.cmd.bits.funct === 0.U && io.cmd.bits.xd && io.cmd.bits.xs1 && io.cmd.bits.xs2) {
+      srcConfig := io.cmd.bits.source
+      dstConfig := io.cmd.bits.destination
+      configured := true.B
+      status := 0.U
+    }
+    when(io.cmd.bits.funct === 1.U && io.cmd.bits.xd && io.cmd.bits.xs1 && !io.cmd.bits.xs2) {
+      status := 2.U
+      when(n === 0.U) { status := 0.U }
+      .elsewhen(configured && validRange && aligned && disjoint) {
+        src := srcConfig
+        dst := dstConfig
+        left := n
+        status := 0.U
+        state := read
+      }
+    }
+  }
+  when(io.request.fire) {
+    assert(left >= 8.U && left(2,0) === 0.U)
+    state := Mux(state === read, readWait, writeWait)
+  }
+  when(io.reply.fire) {
+    when(io.reply.bits.error) {
+      // Even a denied write can leave earlier units committed: never CPU-retry.
+      status := 3.U
+      state := complete
+    }.elsewhen(state === readWait) {
+      buffer := io.reply.bits.data
+      state := write
+    }.otherwise {
+      when(left === 8.U) { state := complete }
+      .otherwise {
+        src := src + 8.U
+        dst := dst + 8.U
+        left := left - 8.U
+        state := read
+      }
+    }
+  }
+  when(state === complete && (!respond || io.resp.fire)) { state := idle }
+
+  // A response cannot be consumed before a corresponding request; only one
+  // memory transaction is outstanding, including when either channel stalls.
+  val outstanding = RegInit(false.B)
+  when(io.request.fire) { assert(!outstanding); outstanding := true.B }
+  when(io.reply.fire) { assert(outstanding); outstanding := false.B }
+  when(state === complete) { assert(!outstanding) }
+  assert(!(io.request.valid && io.reply.ready))
+  val stalled = RegNext(io.request.valid && !io.request.ready, false.B)
+  val previous = RegNext(io.request.bits.asUInt)
+  when(stalled) { assert(io.request.valid && io.request.bits.asUInt === previous) }
+}
diff --git a/generators/chipyard/src/main/scala/dma/RoCCDMA.scala b/generators/chipyard/src/main/scala/dma/RoCCDMA.scala
new file mode 100644
index 0000000..9ff18dd
--- /dev/null
+++ b/generators/chipyard/src/main/scala/dma/RoCCDMA.scala
@@ -0,0 +1,79 @@
+package chipyard.dma
+
+import chisel3._
+import chisel3.util._
+import org.chipsalliance.cde.config.{Config, Parameters}
+import org.chipsalliance.diplomacy.lazymodule.LazyModule
+import freechips.rocketchip.diplomacy.IdRange
+import freechips.rocketchip.subsystem.ExtMem
+import freechips.rocketchip.tile._
+import freechips.rocketchip.tilelink._
+
+class RoCCDMA(val delay: Double = 0.0)(implicit p: Parameters) extends LazyRoCC(OpcodeSet.custom0) {
+  val client = TLClientNode(Seq(TLMasterPortParameters.v1(Seq(
+    TLMasterParameters.v1(name = "rocc-dma", sourceId = IdRange(0, 1))))))
+  // Test-only random A/D delays use an existing adapter; no interconnect edits.
+  if (delay > 0) tlNode := TLDelayer(delay) := client else tlNode := client
+  override lazy val module = new RoCCDMAModule(this)
+}
+class RoCCDMAModule(outer: RoCCDMA)(implicit p: Parameters) extends LazyRoCCModuleImp(outer) {
+  require(io.cmd.bits.rs1.getWidth == 64, "DMA ABI requires RV64")
+  val region = p(ExtMem).get.master
+  val controller = Module(new DMAController(region.base, region.size))
+  controller.io.cmd.valid := io.cmd.valid
+  io.cmd.ready := controller.io.cmd.ready
+  controller.io.cmd.bits.funct := io.cmd.bits.inst.funct
+  controller.io.cmd.bits.source := io.cmd.bits.rs1
+  controller.io.cmd.bits.destination := io.cmd.bits.rs2
+  controller.io.cmd.bits.rd := io.cmd.bits.inst.rd
+  controller.io.cmd.bits.xd := io.cmd.bits.inst.xd
+  controller.io.cmd.bits.xs1 := io.cmd.bits.inst.xs1
+  controller.io.cmd.bits.xs2 := io.cmd.bits.inst.xs2
+  io.resp.valid := controller.io.resp.valid
+  controller.io.resp.ready := io.resp.ready
+  io.resp.bits.rd := controller.io.resp.bits.rd
+  io.resp.bits.data := controller.io.resp.bits.status
+  io.busy := controller.io.busy
+  io.interrupt := false.B
+  // Reserved for a future L1 policy; version 1 uses only coherent TileLink.
+  io.mem.req.valid := false.B
+  io.mem.s1_kill := false.B
+  io.mem.s2_kill := false.B
+  io.fpu_req.valid := false.B
+  io.fpu_resp.ready := true.B
+
+  val (mem, edge) = outer.client.out.head
+  val beatBytes = edge.bundle.dataBits / 8
+  require(beatBytes >= 8 && isPow2(beatBytes))
+  val request = controller.io.request
+  val address = request.bits.address(edge.bundle.addressBits - 1, 0)
+  // TileLink sub-beat reads return data in the addressed byte lanes.
+  def shift(a: UInt): UInt = if (beatBytes == 8) 0.U else Cat(a(log2Ceil(beatBytes)-1,3), 0.U(6.W))
+  val readShift = Reg(UInt(log2Ceil(beatBytes * 8).W))
+  val get = edge.Get(0.U, address, 3.U)
+  val put = edge.Put(0.U, address, 3.U, request.bits.data << shift(address))
+  mem.a.valid := request.valid
+  mem.a.bits := Mux(request.bits.write, put._2, get._2)
+  request.ready := mem.a.ready
+  when(mem.a.fire) {
+    assert(Mux(request.bits.write, put._1, get._1))
+    readShift := shift(address)
+  }
+  controller.io.reply.valid := mem.d.valid
+  mem.d.ready := controller.io.reply.ready
+  controller.io.reply.bits.data := mem.d.bits.data >> readShift
+  controller.io.reply.bits.error := mem.d.bits.denied || mem.d.bits.corrupt
+  when(mem.d.fire) {
+    assert(mem.d.bits.source === 0.U)
+    assert(mem.d.bits.size === 3.U)
+    assert(mem.d.bits.opcode === TLMessages.AccessAck || mem.d.bits.opcode === TLMessages.AccessAckData)
+  }
+  mem.b.ready := true.B
+  mem.c.valid := false.B
+  mem.c.bits := DontCare
+  mem.e.valid := false.B
+  mem.e.bits := DontCare
+}
+class WithRoCCDMA(delay: Double = 0.0) extends Config((site, here, up) => {
+  case BuildRoCC => up(BuildRoCC) :+ ((p: Parameters) => LazyModule(new RoCCDMA(delay)(p)))
+})
